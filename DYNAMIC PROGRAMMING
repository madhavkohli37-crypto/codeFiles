//CODE AFTER DP OPTIMISATION (MEMORISATION)
#include<bits/stdc++.h>
using namespace std;
int dp[1000];
int F(int n) {
  if(dp[n]!=-1) {
    return dp[n];
  }
  dp[n]=F(n-1)+F(n-2);
  return dp[n];
}
int main() {
  int n;
  cin>>n;
  memset(dp,-1,sizeof(dp));
  dp[0]=0;
  dp[1]=1;
  cout<<F(n)<<endl;
  for(int x:dp) {
    cout<<x<<" ";
  }
} 
