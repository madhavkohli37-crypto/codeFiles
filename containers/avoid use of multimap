#include<iostream>
#include<string>
#include<set>
#include<map>
#include<unordered_map>
#include<unordered_set>
#include<utility>
using namespace std;
int main() {
//This is the way by which we can avoid making a multimap and diretly store multiple similar keys
    set<pair<int,int>>s;
    map<pair<string,int>,int>mp;
    int n;
    cin>>n;
    for(int i=0;i<n;i++) {
        int x;
        string str;
        cin>>str>>x;
        pair<pair<string,int>,int> p={{str,i},x};
        mp.insert(p);
    }
    for(auto it=mp.begin();it!=mp.end();it++) {
        cout<<(it->first).first<<" "<<(it->first).second<<" "<<it->second<<endl;
    }
//similar things can be done for a multiset also
}
